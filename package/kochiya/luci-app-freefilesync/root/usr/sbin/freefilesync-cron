#!/bin/sh
#
# Generate/remove the FreeFileSync block in /etc/crontabs/root.
# The block is delimited by markers so unrelated cron entries are preserved.
#

. /lib/functions.sh

CRONTAB=/etc/crontabs/root
BEGIN="# BEGIN luci-app-freefilesync"
END="# END luci-app-freefilesync"

config_load freefilesync
config_get global_enabled main enabled 1

add_job() {
	local section="$1"
	local cfg schedule name job_enabled

	config_get cfg "$section" config
	config_get schedule "$section" schedule
	config_get name "$section" name
	config_get job_enabled "$section" enabled 1

	[ "$job_enabled" = "1" ] || return 0
	[ -n "$cfg" ] && [ -f "$cfg" ] || return 0
	[ -n "$schedule" ] || return 0

	[ -n "$name" ] || name="$section"
	case "$name" in
		""|*[!A-Za-z0-9_.-]*) return 0 ;;
	esac

	echo "$schedule" | grep -Eq '^[0-9*/,[:space:]-]+$' || return 0
	set -f
	set -- $schedule
	set +f
	[ $# -eq 5 ] || return 0

	echo "$schedule /usr/sbin/freefilesync-run '$name' >/dev/null 2>&1"
}

write_block() {
	local tmp jobs

	mkdir -p "$(dirname "$CRONTAB")"
	tmp="$(mktemp)"
	jobs="$(mktemp)"

	if [ -f "$CRONTAB" ]; then
		awk -v b="$BEGIN" -v e="$END" '
			$0 == b { skip = 1; next }
			$0 == e { skip = 0; next }
			!skip   { print }
		' "$CRONTAB" > "$tmp"
	else
		: > "$tmp"
	fi

	if [ "$global_enabled" = "1" ]; then
		config_foreach add_job job >> "$jobs"
	fi

	if [ -s "$jobs" ]; then
		printf '%s\n' "$BEGIN" >> "$tmp"
		cat "$jobs" >> "$tmp"
		printf '%s\n' "$END" >> "$tmp"
	fi

	if ! cmp -s "$tmp" "$CRONTAB" 2>/dev/null; then
		mv "$tmp" "$CRONTAB"
		chmod 600 "$CRONTAB"
		/etc/init.d/cron restart >/dev/null 2>&1
	else
		rm -f "$tmp"
	fi

	rm -f "$jobs"
}

case "$1" in
	update|start|reload)
		write_block
		;;
	clear|stop)
		global_enabled=0
		write_block
		;;
	status)
		[ -f "$CRONTAB" ] || exit 0
		awk -v b="$BEGIN" -v e="$END" '
			$0 == b { show = 1 }
			show    { print }
			$0 == e { show = 0 }
		' "$CRONTAB"
		;;
	*)
		echo "usage: $0 update|clear|status" >&2
		exit 2
		;;
esac
