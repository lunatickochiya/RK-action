diff --git a/FreeFileSync/Source/afs/sftp.cpp b/FreeFileSync/Source/afs/sftp.cpp
index 4d9bb23..4d58d26 100644
--- a/FreeFileSync/Source/afs/sftp.cpp
+++ b/FreeFileSync/Source/afs/sftp.cpp
@@ -65,6 +65,15 @@ const long SFTP_DEFAULT_PERMISSION_FOLDER = LIBSSH2_SFTP_S_IRWXU |
 
 //attention: if operation fails due to time out, e.g. file copy, the cleanup code may hang, too => total delay = 2 x time out interval
 
+//libssh2 >= 1.11 no longer exports these internal constants; the values are
+//part of its SFTP wire protocol implementation and stable for the 1.x series.
+#ifndef MAX_SFTP_READ_SIZE
+#define MAX_SFTP_READ_SIZE 30000
+#endif
+#ifndef MAX_SFTP_OUTGOING_SIZE
+#define MAX_SFTP_OUTGOING_SIZE 30000
+#endif
+
 const size_t SFTP_OPTIMAL_BLOCK_SIZE_READ  = 16 * MAX_SFTP_READ_SIZE;     //https://github.com/libssh2/libssh2/issues/90
 const size_t SFTP_OPTIMAL_BLOCK_SIZE_WRITE = 16 * MAX_SFTP_OUTGOING_SIZE; //need large buffer to mitigate libssh2 stupidly waiting on "acks": https://www.libssh2.org/libssh2_sftp_write.html
 static_assert(MAX_SFTP_READ_SIZE == 30000 && MAX_SFTP_OUTGOING_SIZE == 30000, "reevaluate optimal block sizes if these constants change!");
diff --git a/libssh2/libssh2_wrap.h b/libssh2/libssh2_wrap.h
index 6bc6c97..d4c6017 100644
--- a/libssh2/libssh2_wrap.h
+++ b/libssh2/libssh2_wrap.h
@@ -195,7 +195,9 @@ std::wstring formatSshStatusCode(int sc)
             ZEN_CASE_RETURN_STRING(LIBSSH2_ERROR_MAC_FAILURE);
             ZEN_CASE_RETURN_STRING(LIBSSH2_ERROR_HASH_INIT);
             ZEN_CASE_RETURN_STRING(LIBSSH2_ERROR_HASH_CALC);
+#ifdef LIBSSH2_ERROR_STORE_OVERFLOW
             ZEN_CASE_RETURN_STRING(LIBSSH2_ERROR_STORE_OVERFLOW);
+#endif
 
         default:
             return replaceCpy<std::wstring>(L"SSH status %x", L"%x", numberTo<std::wstring>(sc));
