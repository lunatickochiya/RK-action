#!/bin/sh /etc/rc.common

START=15
STOP=99
USE_PROCD=1

start_service() {
	. /lib/functions.sh
	[ "$(board_name)" = "shimeta,rk3588-aiot3588a" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/aiot3588a-mcu-watchdog
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
