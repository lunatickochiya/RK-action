diff --git a/package/kernel/linux/modules/crypto.mk b/package/kernel/linux/modules/crypto.mk
index 869601eb703..d3c41fbd90e 100644
--- a/package/kernel/linux/modules/crypto.mk
+++ b/package/kernel/linux/modules/crypto.mk
@@ -561,7 +561,13 @@ $(eval $(call KernelPackage,crypto-kpp))
 
 define KernelPackage/crypto-lib-chacha20
   TITLE:=ChaCha library interface
-  KCONFIG:=CONFIG_CRYPTO_LIB_CHACHA
+  # Keep the aarch64/arm symbol in the base definition as well: the package
+  # metadata dump runs with DUMP=1 (no .config), so the
+  # KernelPackage/.../$(CRYPTO_TARGET) variant is not evaluated and its
+  # KCONFIG entry would be missing from the kernel config. FILES is evaluated
+  # at build time (with .config) and still expects arch/arm64/.../chacha-neon.ko,
+  # which then fails with "ERROR: module ... is missing".
+  KCONFIG:=CONFIG_CRYPTO_LIB_CHACHA CONFIG_CRYPTO_CHACHA20_NEON
   HIDDEN:=1
   FILES:=$(LINUX_DIR)/lib/crypto/libchacha.ko
   $(call AddDepends/crypto)
@@ -654,7 +660,8 @@ $(eval $(call KernelPackage,crypto-lib-curve25519))
 
 define KernelPackage/crypto-lib-poly1305
   TITLE:=Poly1305 library interface
-  KCONFIG:=CONFIG_CRYPTO_LIB_POLY1305
+  # See crypto-lib-chacha20 above (same metadata/arch-variant issue).
+  KCONFIG:=CONFIG_CRYPTO_LIB_POLY1305 CONFIG_CRYPTO_POLY1305_NEON
   HIDDEN:=1
   FILES:=$(LINUX_DIR)/lib/crypto/libpoly1305.ko
   $(call AddDepends/crypto,+kmod-crypto-hash)
