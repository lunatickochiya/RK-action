@@ -1398,6 +1419,431 @@ const preferApi = (apiMethod, rpcMethod) => (...args) => {
 	return apiReady.then(([ok, host]) => ok ? apiMethod(...args) : rpcMethod(...args));
 };
 
+
+// ---------------------------------------------------------------------------
+// One-click container upgrade
+// ---------------------------------------------------------------------------
+
+const upgrade_api = {
+	container_create: preferApi(jsapi.container_create, container_create),
+	container_inspect: preferApi(jsapi.container_inspect, container_inspect),
+	container_pause: preferApi(jsapi.container_pause, container_pause),
+	container_remove: preferApi(jsapi.container_remove, container_remove),
+	container_rename: preferApi(jsapi.container_rename, container_rename),
+	container_start: preferApi(jsapi.container_start, container_start),
+	container_stop: preferApi(jsapi.container_stop, container_stop),
+	image_inspect: preferApi(jsapi.image_inspect, image_inspect),
+	image_list: preferApi(jsapi.image_list, image_list),
+};
+
+function split_image_ref(imageRef) {
+	let ref = String(imageRef || '').trim();
+	if (!ref)
+		return null;
+
+	let digest = '';
+	const at = ref.indexOf('@');
+	if (at !== -1) {
+		digest = ref.slice(at + 1);
+		ref = ref.slice(0, at);
+	}
+
+	let tag = '';
+	const lastSlash = ref.lastIndexOf('/');
+	const lastColon = ref.lastIndexOf(':');
+	if (lastColon > lastSlash) {
+		tag = ref.slice(lastColon + 1);
+		ref = ref.slice(0, lastColon);
+	}
+
+	if (!ref)
+		return null;
+
+	return {
+		name: ref,
+		tag: tag || 'latest',
+		digest: digest,
+		pullFromImage: digest ? `${ref}@${digest}` : ref,
+		pullTag: digest ? '' : (tag || 'latest'),
+	};
+}
+
+function upgrade_error_message(response, fallback) {
+	if (!response)
+		return `${fallback}: ${_('Docker API is not available')}`;
+
+	const body = response.body;
+	const detail = (body && typeof body === 'object') ? (body.message || body.error) : body;
+	return detail ? `${fallback}: ${detail}` : `${fallback} (HTTP ${response.code})`;
+}
+
+async function upgrade_docker_call(method, params, label) {
+	const response = await method(params);
+	if (!response || response.code >= 300)
+		throw new Error(upgrade_error_message(response, label));
+	return response;
+}
+
+async function resolve_upgrade_image_ref(container) {
+	const configured = String(container?.Config?.Image || '').trim();
+	if (configured && !configured.startsWith('sha256:'))
+		return configured;
+
+	// Containers created from an image ID have no pullable reference in
+	// Config.Image, so look the ID up in the image list and use its first tag.
+	const response = await upgrade_api.image_list({ query: { all: true } });
+	const images = Array.isArray(response?.body) ? response.body : [];
+	const image = images.find(img => img.Id === container.Image || img.Id === configured);
+	const tags = (image?.RepoTags || []).filter(tag => tag && tag !== '<none>:<none>');
+	return tags[0] || '';
+}
+
+function build_upgrade_create_body(container, imageRef) {
+	const config = JSON.parse(JSON.stringify(container.Config || {}));
+	const hostConfig = JSON.parse(JSON.stringify(container.HostConfig || {}));
+
+	config.Image = imageRef;
+
+	// Docker reports the auto-generated short container ID as hostname.
+	const autoHostname = String(container.Id || '').substring(0, 12);
+	if (config.Hostname === autoHostname || config.Hostname === container.Id)
+		delete config.Hostname;
+
+	// Not accepted by newer Docker APIs (MAC addresses are per endpoint now).
+	const customMac = config.MacAddress;
+	delete config.MacAddress;
+	delete config.ArgsEscaped;
+	delete config.OnBuild;
+
+	// Rebuild mounts from the container's actual mounts. Passing both Binds and
+	// Mounts can make the daemon reject the request with duplicate mount points.
+	const mounts = [];
+	const tmpfsPaths = new Set(Object.keys(hostConfig.Tmpfs || {}));
+	for (const source of (container.Mounts || [])) {
+		if (!source?.Destination)
+			continue;
+
+		// Tmpfs mounts are already described by HostConfig.Tmpfs.
+		if (source.Type === 'tmpfs' && tmpfsPaths.has(source.Destination))
+			continue;
+
+		const mount = {
+			Type: source.Type || 'bind',
+			Target: source.Destination,
+			ReadOnly: source.RW === false,
+		};
+
+		switch (mount.Type) {
+		case 'bind':
+			mount.Source = source.Source || '';
+			if (source.Propagation)
+				mount.BindOptions = { Propagation: source.Propagation };
+			break;
+		case 'volume':
+			mount.Source = source.Name || source.Source || '';
+			if (source.VolumeOptions)
+				mount.VolumeOptions = source.VolumeOptions;
+			break;
+		case 'tmpfs':
+			mount.Source = '';
+			if (source.TmpfsOptions)
+				mount.TmpfsOptions = source.TmpfsOptions;
+			break;
+		case 'image':
+			mount.Source = source.Source || imageRef;
+			if (source.ImageOptions)
+				mount.ImageOptions = source.ImageOptions;
+			break;
+		default:
+			mount.Source = source.Source || '';
+			break;
+		}
+
+		mounts.push(mount);
+	}
+
+	if (mounts.length) {
+		hostConfig.Mounts = mounts;
+		delete hostConfig.Binds;
+	}
+	else if (Array.isArray(hostConfig.Mounts) && hostConfig.Mounts.length) {
+		delete hostConfig.Binds;
+	}
+	else {
+		delete hostConfig.Mounts;
+	}
+
+	// Rebuild the endpoint configuration from the live networks. Static IPs,
+	// aliases and per-network settings survive the re-creation.
+	const networkMode = String(hostConfig.NetworkMode || '');
+	const skipEndpoints = ['host', 'none'].includes(networkMode) || networkMode.startsWith('container:');
+	const endpoints = {};
+
+	if (!skipEndpoints) {
+		for (const [netName, net] of Object.entries(container.NetworkSettings?.Networks || {})) {
+			if (!net?.NetworkID)
+				continue;
+
+			const endpoint = {};
+			if (Array.isArray(net.Aliases) && net.Aliases.length)
+				endpoint.Aliases = net.Aliases;
+			if (Array.isArray(net.Links) && net.Links.length)
+				endpoint.Links = net.Links;
+			if (net.DriverOpts && Object.keys(net.DriverOpts).length)
+				endpoint.DriverOpts = net.DriverOpts;
+			if (net.GwPriority)
+				endpoint.GwPriority = net.GwPriority;
+			if (customMac && net.MacAddress)
+				endpoint.MacAddress = net.MacAddress;
+
+			const ipam = {};
+			if (net.IPAMConfig?.IPv4Address)
+				ipam.IPv4Address = net.IPAMConfig.IPv4Address;
+			if (net.IPAMConfig?.IPv6Address)
+				ipam.IPv6Address = net.IPAMConfig.IPv6Address;
+			if (Array.isArray(net.IPAMConfig?.LinkLocalIPs) && net.IPAMConfig.LinkLocalIPs.length)
+				ipam.LinkLocalIPs = net.IPAMConfig.LinkLocalIPs;
+			if (Object.keys(ipam).length)
+				endpoint.IPAMConfig = ipam;
+
+			endpoints[netName] = endpoint;
+		}
+	}
+
+	const body = { ...config, HostConfig: hostConfig };
+	if (Object.keys(endpoints).length)
+		body.NetworkingConfig = { EndpointsConfig: endpoints };
+
+	return {
+		name: String(container.Name || '').replace(/^\/+/, ''),
+		body,
+	};
+}
+
+function pull_image_for_upgrade(view, imageRef) {
+	return new Promise((resolve, reject) => {
+		const ref = split_image_ref(imageRef);
+		if (!ref) {
+			reject(new Error(_('Invalid image reference: %s').format(imageRef)));
+			return;
+		}
+
+		let streamError = null;
+		const query = ref.digest
+			? { fromImage: ref.pullFromImage }
+			: { fromImage: ref.name, tag: ref.pullTag };
+
+		view.handleXHRTransfer({
+			q_params: { query },
+			commandCPath: '/images/create',
+			commandDPath: '/images/create',
+			commandTitle: _('Pulling image') + ': ' + imageRef,
+			commandMessage: _('Pulling the latest image…'),
+			successMessage: _('Image pulled successfully'),
+			onUpdate: (msg) => {
+				if (msg?.error)
+					streamError = msg.error;
+			},
+			onSuccess: () => {
+				if (streamError)
+					reject(new Error(streamError));
+				else
+					resolve();
+			},
+			onError: (msg) => reject(new Error(msg)),
+			noFileUpload: true,
+		}).catch(reject);
+	});
+}
+
+function confirm_upgrade(container, imageRef) {
+	const name = String(container.Name || '').replace(/^\/+/, '');
+	return new Promise((resolve) => {
+		ui.showModal(_('Upgrade container'), [
+			E('p', {}, _('Pull the latest image and recreate this container with the same settings. Volumes and bind mounts are preserved.')),
+			E('div', { 'class': 'cbi-value' }, [
+				E('label', { 'class': 'cbi-value-title' }, _('Container')),
+				E('div', { 'class': 'cbi-value-field' }, [name]),
+			]),
+			E('div', { 'class': 'cbi-value' }, [
+				E('label', { 'class': 'cbi-value-title' }, _('Image')),
+				E('div', { 'class': 'cbi-value-field' }, [imageRef]),
+			]),
+			E('div', { 'class': 'right' }, [
+				E('button', {
+					'class': 'cbi-button',
+					'click': () => { ui.hideModal(); resolve(false); },
+				}, [_('Cancel')]),
+				' ',
+				E('button', {
+					'class': 'cbi-button cbi-button-apply',
+					'click': () => { ui.hideModal(); resolve(true); },
+				}, [_('Upgrade')]),
+			]),
+		]);
+	});
+}
+
+async function upgrade_container(view, containerId, options = {}) {
+	if (view.__upgrading) {
+		view.showNotification(_('Upgrade'), _('Another container upgrade is already in progress.'), 5000, 'warning');
+		return false;
+	}
+
+	view.__upgrading = true;
+	let containerName = '';
+	let oldId = null;
+	let newId = null;
+	let oldRenamed = false;
+	let oldStopped = false;
+	let wasRunning = false;
+	let wasPaused = false;
+	let autoRemove = false;
+	let succeeded = false;
+
+	try {
+		const inspect = await upgrade_api.container_inspect({ id: containerId });
+		if (!inspect || inspect.code >= 300 || !inspect.body?.Id)
+			throw new Error(upgrade_error_message(inspect, _('Unable to inspect the container')));
+
+		const container = inspect.body;
+		oldId = container.Id;
+		containerName = String(container.Name || '').replace(/^\/+/, '') || oldId.substring(0, 12);
+
+		const imageRef = await resolve_upgrade_image_ref(container);
+		if (!imageRef)
+			throw new Error(_('The container image has no repository tag and cannot be pulled. Tag the image first.'));
+
+		if (!await confirm_upgrade(container, imageRef))
+			return false;
+
+		await pull_image_for_upgrade(view, imageRef);
+
+		const image = await upgrade_api.image_inspect({ id: imageRef });
+		if (!image || image.code >= 300 || !image.body?.Id)
+			throw new Error(upgrade_error_message(image, _('Unable to inspect the pulled image')));
+
+		if (image.body.Id === container.Image) {
+			view.showNotification(
+				_('Upgrade'),
+				_('Image "%s" is already up to date. The container was not changed.').format(imageRef),
+				6000,
+				'info'
+			);
+			return false;
+		}
+
+		const status = view.getContainerStatus(container);
+		wasRunning = (status === 'running' || status === 'restarting');
+		wasPaused = (status === 'paused');
+		autoRemove = container.HostConfig?.AutoRemove === true;
+
+		const { name, body } = build_upgrade_create_body(container, imageRef);
+		const backupName = `${name}-upgrade-${Date.now().toString(36)}`;
+
+		ui.showModal(_('Upgrade container'), [
+			E('p', {}, _('Recreating container "%s"…').format(name)),
+		]);
+
+		// Rename first so the original name is available for the new container.
+		await upgrade_docker_call(upgrade_api.container_rename, {
+			id: oldId,
+			query: { name: backupName },
+		}, _('Rename container'));
+		oldRenamed = true;
+
+		const created = await upgrade_docker_call(upgrade_api.container_create, {
+			query: { name },
+			body,
+		}, _('Create container'));
+		newId = created.body?.Id;
+		if (!newId)
+			throw new Error(_('Docker did not return the new container ID'));
+
+		if (wasRunning || wasPaused) {
+			await upgrade_docker_call(upgrade_api.container_stop, {
+				id: oldId,
+				query: { t: 10 },
+			}, _('Stop container'));
+			oldStopped = true;
+		}
+
+		await upgrade_docker_call(upgrade_api.container_start, {
+			id: newId,
+			query: {},
+		}, _('Start container'));
+
+		succeeded = true;
+		ui.hideModal();
+		oldRenamed = false;
+
+		try {
+			const removed = await upgrade_api.container_remove({ id: oldId, query: { force: false } });
+			if (removed && removed.code >= 300 && removed.code !== 404)
+				throw new Error(upgrade_error_message(removed, _('Remove container')));
+		} catch (err) {
+			view.showNotification(
+				_('Upgrade'),
+				_('The previous container could not be removed and was kept as "%s".').format(backupName),
+				7000,
+				'warning'
+			);
+		}
+
+		view.showNotification(
+			_('Upgrade'),
+			_('Container "%s" upgraded successfully.').format(name),
+			5000,
+			'success'
+		);
+
+		if (options.onSuccess)
+			try { options.onSuccess(newId); } catch (e) { console.warn('Upgrade callback failed:', e); }
+
+		return newId;
+	} catch (err) {
+		ui.hideModal();
+
+		let message = err?.message || String(err);
+
+		// Remove the partially created container, then restore the old one.
+		if (!succeeded) {
+			if (newId) {
+				try {
+					await upgrade_api.container_remove({ id: newId, query: { force: true } });
+				} catch (e) { }
+			}
+
+			if (autoRemove && oldStopped) {
+				message += '\n' + _('The previous container was configured with AutoRemove and has already been removed.');
+			}
+			else if (oldRenamed && oldId) {
+				try {
+					await upgrade_api.container_rename({ id: oldId, query: { name: containerName } });
+				} catch (e) {
+					message += '\n' + _('Failed to restore the previous container name: %s').format(e?.message || e);
+				}
+
+				if (oldStopped || wasPaused) {
+					try {
+						await upgrade_api.container_start({ id: oldId, query: {} });
+						if (wasPaused)
+							await upgrade_api.container_pause({ id: oldId });
+					} catch (e) {
+						message += '\n' + _('Failed to restart the previous container: %s').format(e?.message || e);
+					}
+				}
+			}
+		}
+
+		view.showNotification(_('Upgrade failed'), message, 10000, 'error');
+		return false;
+	} finally {
+		view.__upgrading = false;
+	}
+}
+
+
 return L.Class.extend({
 	Types: Types,
 	ActionTypes: ActionTypes,
