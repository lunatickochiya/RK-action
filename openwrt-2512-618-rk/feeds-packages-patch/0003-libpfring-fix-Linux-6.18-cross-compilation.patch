From 945a6af1c121ab721ee3317292780f9cc31148fd Mon Sep 17 00:00:00 2001
From: lunatickochiya <125438787@qq.com>
Date: Mon, 28 Sep 2026 16:12:52 +0800
Subject: [PATCH 03/10] libpfring: fix Linux 6.18 cross compilation

---
 libs/libpfring/Makefile                             |  2 ++
 .../patches/103-kernel-6.18-dev-flags.patch         | 13 +++++++++++++
 2 files changed, 15 insertions(+)
 create mode 100644 libs/libpfring/patches/103-kernel-6.18-dev-flags.patch

diff --git a/libs/libpfring/Makefile b/libs/libpfring/Makefile
index eeb20f0..ddc9a9e 100644
--- a/libs/libpfring/Makefile
+++ b/libs/libpfring/Makefile
@@ -61,6 +61,8 @@ CONFIGURE_VARS += \
 	MACHINE="$(ARCH)" \
 	ac_cv_lib_nl_3_nl_socket_alloc=no
 
+CONFIGURE_ARGS += --disable-archopt
+
 define Build/Compile
 	$(MAKE) -C "$(LINUX_DIR)" \
 		KERNEL_DIR="$(LINUX_DIR)" \
diff --git a/libs/libpfring/patches/103-kernel-6.18-dev-flags.patch b/libs/libpfring/patches/103-kernel-6.18-dev-flags.patch
new file mode 100644
index 0000000..1daa62d
--- /dev/null
+++ b/libs/libpfring/patches/103-kernel-6.18-dev-flags.patch
@@ -0,0 +1,13 @@
+--- a/kernel/pf_ring.c
++++ b/kernel/pf_ring.c
+@@ -5269,3 +5269,3 @@
+   rtnl_lock();
+-  if_flags = (short) dev_get_flags(netdev);
++  if_flags = (short) netdev->flags;
+   rtnl_unlock();
+@@ -5285 +5285 @@
+-  if_flags = (short) dev_get_flags(netdev);
++  if_flags = (short) netdev->flags;
+@@ -5308 +5308 @@
+-  if_flags = (short) dev_get_flags(netdev);
++  if_flags = (short) netdev->flags;
-- 
2.55.0

