# ===== ztl-lite（Linux 6.6 / rockchip-nftables）=====
# ztl-lite 精简版（NAS 存储 + 容器 / VPN，去掉代理/下载/媒体/监控/多主题）
# 分区顺序：基础/设备 -> 网络 -> 代理/VPN/穿透 -> IPTV -> 下载 -> 存储(NAS)
#           -> 容器 -> 打印 -> 主题 -> 监控 -> 网络服务 -> 工具 -> 视频加速

# ===== 基础参数 =====
CONFIG_BUILD_PATENTED=y
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=3650
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256

# ===== 机型/设备 =====
CONFIG_PACKAGE_arm-trusted-firmware-rk3399=y
CONFIG_PACKAGE_auto-resize-rootfs-script=y
CONFIG_PACKAGE_autoset=y
CONFIG_PACKAGE_autoset-uci-rockchip=y
CONFIG_PACKAGE_autoset_INCLUDE_RESIZEFS=y
CONFIG_PACKAGE_autoset_INCLUDE_filesystem=y
CONFIG_PACKAGE_autoset_INCLUDE_temperature=y
CONFIG_PACKAGE_autoset_INCLUDE_temperature_script=y
CONFIG_PACKAGE_autoset_INCLUDE_uci_rockchip=y
CONFIG_PACKAGE_autoset_INCLUDE_usb_storage=y

# ===== 网络基础/防火墙 =====
# CONFIG_PACKAGE_firewall=y
# CONFIG_PACKAGE_ip6tables-mod-nat=y
# CONFIG_PACKAGE_ip6tables-nft=y
# CONFIG_PACKAGE_ip6tables-zz-legacy=y
CONFIG_PACKAGE_ipset=y
# CONFIG_PACKAGE_iptables-nft=y
# CONFIG_PACKAGE_iptables-zz-legacy=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-ebtables-nft=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nat46=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tcp-hybla=y
CONFIG_PACKAGE_kmod-tcp-scalable=y
CONFIG_PACKAGE_kmod-tls=y
# CONFIG_PACKAGE_luci-app-3ginfo=y
CONFIG_PACKAGE_luci-app-modechange=y
# CONFIG_PACKAGE_luci-app-modemband=y
# CONFIG_PACKAGE_luci-app-modeminfo=y
# CONFIG_PACKAGE_luci-app-usbmodem=y
# CONFIG_PACKAGE_luci-proto-qmi is not set  # 非 4G/5G 机型不需要 QMI

# ===== 代理/科学上网 =====
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
# CONFIG_PACKAGE_luci-app-ssr-plus is not set  # SSR-Plus 依赖 ruby -> rust host ~4h20m，全机型不再集成
# CONFIG_PACKAGE_ruby is not set
# CONFIG_PACKAGE_ruby-yaml is not set

# ===== VPN/隧道 =====
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-openvpn-server-client=y
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_wireguard-tools=y

# ===== 内网穿透/远程 =====
CONFIG_PACKAGE_luci-app-sakurafrp=y

# ===== 存储/文件共享（NAS） =====
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_cryptsetup=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_kmod-dm=y
CONFIG_PACKAGE_kmod-dm-raid=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_kmod-fs-nfs=y
CONFIG_PACKAGE_kmod-fs-nfs-v4=y
CONFIG_PACKAGE_kmod-fs-nfsd=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-md-raid456=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_libblkid=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_kmod_md_linear=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_kmod_md_raid456=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_mdadm=y
CONFIG_PACKAGE_luci-app-harbor-file=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-ksmbd=y
# CONFIG_PACKAGE_luci-app-partexp=y
# CONFIG_PACKAGE_luci-app-quickfile is not set  # Rust(quickfile) 触发 rust host 构建 ~4h20m
CONFIG_PACKAGE_luci-app-vsftpd=y
CONFIG_PACKAGE_lvm2=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_nfs-kernel-server-v4=y
CONFIG_PACKAGE_ntfs-3g-utils=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_smartd=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_wsdd2=y
CONFIG_PACKAGE_xfs-admin=y
CONFIG_PACKAGE_xfs-fsck=y
CONFIG_PACKAGE_xfs-growfs=y
CONFIG_PACKAGE_xfs-mkfs=y

# ===== 容器/Docker =====
CONFIG_DOCKER_CGROUP_OPTIONS=y
CONFIG_DOCKER_CHECK_CONFIG=y
CONFIG_DOCKER_NET_ENCRYPT=y
CONFIG_DOCKER_NET_MACVLAN=y
CONFIG_DOCKER_NET_OVERLAY=y
CONFIG_DOCKER_NET_TFTP=y
CONFIG_DOCKER_OPTIONAL_FEATURES=y
CONFIG_DOCKER_STO_BTRFS=y
CONFIG_DOCKER_STO_DEVMAPPER=y
CONFIG_DOCKER_STO_EXT4=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y

# ===== 打印/外设 =====
CONFIG_PACKAGE_avahi-utils=y
CONFIG_PACKAGE_brlaser=y
CONFIG_PACKAGE_cups-bsd=y
CONFIG_PACKAGE_cups-client=y
CONFIG_PACKAGE_cups-filters=y
CONFIG_PACKAGE_cups-ppdc=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_libcupsimage=y

# ===== UPS/电源管理 =====
CONFIG_NUT_DRIVER_USB=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_luci-app-nut=y
CONFIG_PACKAGE_nut-driver-usbhid-ups=y
CONFIG_PACKAGE_nut-server=y
CONFIG_PACKAGE_nut-upsc=y
CONFIG_PACKAGE_nut-upsmon=y

# ===== 主题/界面 =====
# CONFIG_PACKAGE_luci-app-alpha-config is not set
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-app-emmc-info=y
CONFIG_PACKAGE_luci-app-istorex=y
# CONFIG_PACKAGE_luci-app-kucat-config=y
# CONFIG_PACKAGE_luci-theme-alpha is not set  # 主题只保留 argon + aurora
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-aurora=y
# CONFIG_PACKAGE_luci-theme-kucat=y
# CONFIG_PACKAGE_luci-theme-lightblue=y
# CONFIG_PACKAGE_luci-theme-openwrt=y

# ===== 监控/系统 =====
# CONFIG_PACKAGE_kmod-ramoops=y
CONFIG_PACKAGE_lm-sensors=y
# CONFIG_PACKAGE_luci-app-netspeedtest=y
# CONFIG_PACKAGE_luci-app-statistics=y

# ===== 网络服务 =====
CONFIG_PACKAGE_avahi-dbus-daemon=y
# CONFIG_PACKAGE_luci-app-haproxy-tcp=y
# CONFIG_PACKAGE_umdns is not set  # mDNS 由 avahi/ksmbd 负责，避免重复

# ===== 工具 =====
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_bmon=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_git-http=y
# CONFIG_PACKAGE_git-lfs=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_jansson=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ncdu=y
CONFIG_PACKAGE_node=y
CONFIG_PACKAGE_node-npm=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_pigz=y
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_uuidgen=y
CONFIG_PACKAGE_wget-ssl=y

# ===== 视频/硬件加速（RKMPP/RGA/NPU/GPU） =====
CONFIG_PACKAGE_ffmpeg-mpp=y
# CONFIG_PACKAGE_kmod-drm-panfrost is not set
CONFIG_PACKAGE_kmod-rga2=y
CONFIG_PACKAGE_kmod-rk_vcodec=y
CONFIG_PACKAGE_libffmpeg-mpp=y
# CONFIG_PACKAGE_libmesa-panfrost is not set  # NAS/IPTV 不需要 OpenGL，mesa+LLVM 单编 1~2h
CONFIG_PACKAGE_rkmpp=y
CONFIG_PACKAGE_rkmpp-demo=y
CONFIG_PACKAGE_rkrga=y

# ===== 构建选项 =====
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_CRYPTO_AUTH=y
CONFIG_LIBCURL_DICT=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
# CONFIG_LIBCURL_GNUTLS is not set
CONFIG_LIBCURL_GOPHER=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_IMAP=y
# CONFIG_LIBCURL_LDAP is not set
# CONFIG_LIBCURL_LDAPS is not set
CONFIG_LIBCURL_LIBCURL_OPTION=y
CONFIG_LIBCURL_LIBIDN2=y
# CONFIG_LIBCURL_MBEDTLS is not set
CONFIG_LIBCURL_NGHTTP2=y
# CONFIG_LIBCURL_NOSSL is not set
CONFIG_LIBCURL_NTLM=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_POP3=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_RTSP=y
CONFIG_LIBCURL_SMB=y
CONFIG_LIBCURL_SMTP=y
CONFIG_LIBCURL_SSH2=y
CONFIG_LIBCURL_TELNET=y
CONFIG_LIBCURL_TFTP=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_LIBCURL_TLS_SRP=y
CONFIG_LIBCURL_UNIX_SOCKETS=y
CONFIG_LIBCURL_VERBOSE=y
# CONFIG_LIBCURL_WOLFSSL is not set
CONFIG_LIBCURL_ZLIB=y
CONFIG_LIBCURL_ZSTD=y
CONFIG_LUA_ECO_MBEDTLS=n
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_PACKAGE_libcurl=y
# CONFIG_PACKAGE_libopenssl-conf=y
# CONFIG_PACKAGE_libopenssl-gost_engine=y
# CONFIG_PACKAGE_libpolarssl is not set
CONFIG_PACKAGE_libwolfssl=n
# CONFIG_PACKAGE_libwolfssl-benchmark is not set
CONFIG_ZLIB_OPTIMIZE_SPEED=y
CONFIG_ZSTD_OPTIMIZE_O3=y

# ===== 其他 =====
CONFIG_FEED_lunatic7=n
# CONFIG_kmod-usb-net-sr9700=y
